# Copy to .env and adjust for your environment.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=habit_tracker
# Use "localhost" when running the API on the host, "db" inside docker-compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

APP_ENV=local

# Shared secret the bot presents to the API on every call. Required by both
# services; generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=

# Required by BOTH services now. The bot talks to Telegram with it; the API
# needs it to verify Mini App initData signatures.
TELEGRAM_BOT_TOKEN=
# Username without the @. Used to build the t.me deep link inside the QR code.
TELEGRAM_BOT_USERNAME=

# Signs the access tokens issued to a TV after a QR approval. Separate from
# INTERNAL_API_KEY so it can be rotated on its own — rotating it is the only way
# to revoke issued tokens. Use at least 32 bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Comma-separated browser origins allowed to call the API. The SPA sends an
# Authorization header, so every request preflights and this must list the
# frontend's real origin. Never "*".
CORS_ORIGINS=http://localhost:5173

# "api" inside docker-compose, "http://localhost:8000" when running the bot on the host.
API_URL=http://api:8000
